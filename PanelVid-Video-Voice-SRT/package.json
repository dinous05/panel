{
  "name": "panelvid-offline",
  "version": "0.1.0",
  "description": "Video editor for pre-cut comic panel images, SRT voice generation and MP4 export",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "app": "electron .",
    "build:renderer": "vite build",
    "build:win": "npm run build:renderer && electron-builder --win portable --x64",
    "test": "node --test"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "vite": "7.1.7"
  },
  "build": {
    "appId": "im.manus.panelvid.offline",
    "productName": "PanelVid Offline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/**/*.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "resources/edge_tts_helper.py",
        "to": "edge_tts_helper.py"
      },
      {
        "from": "resources/chatterbox_batch.py",
        "to": "chatterbox_batch.py"
      },
      {
        "from": "resources/vieneu_batch.py",
        "to": "vieneu_batch.py"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "PanelVid-Offline-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "PanelVid-Offline-${version}-win-${arch}.${ext}"
    },
    "asar": true
  }
}
